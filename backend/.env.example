DATABASE_URL=postgresql+asyncpg://naryad:naryad@localhost:5432/naryad
# Сгенерируйте свой: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-random-chars
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
MEDIA_DIR=media
AI_MONITOR_ENABLED=true
DEADLINE_CHECK_INTERVAL_SEC=60
REMINDER_BEFORE_MIN=30
PLANT_UTC_OFFSET_HOURS=5
# Опционально: смысловая ИИ-проверка нарядов через Claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
