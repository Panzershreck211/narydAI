DATABASE_URL=postgresql+asyncpg://naryad:naryad@localhost:5432/naryad
# Можно оставить пустым — API сам сгенерирует ключ при первом старте и сохранит его в БД.
# Свой ключ: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
MEDIA_DIR=media
AI_MONITOR_ENABLED=true
DEADLINE_CHECK_INTERVAL_SEC=60
REMINDER_BEFORE_MIN=30
PLANT_UTC_OFFSET_HOURS=5
# ИИ-помощник и проверка нарядов — Google Gemini. Бесплатный ключ: aistudio.google.com → Get API key
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Опционально: путь к service-account JSON Firebase для push
FCM_CREDENTIALS_FILE=
