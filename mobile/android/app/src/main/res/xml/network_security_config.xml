<?xml version="1.0" encoding="utf-8"?>
<!-- Сервер НарядAI в локальной сети работает по http (адрес вводится на экране входа:
     эмулятор — 10.0.2.2, телефон — IP компьютера в Wi-Fi). Android не умеет разрешать http
     для «любого IP локальной сети», поэтому http разрешён для всех адресов.
     Для продакшена: поставьте сервер за HTTPS и верните cleartextTrafficPermitted="false". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
